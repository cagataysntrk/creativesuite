# Bağımlılıklar TAM sürüme sabitlenir — aralık yok.
# Gerekçe: "bir ay ihmal edilse de çalışır" (değişmez ilke 12). Bir caret aralığı,
# dokunulmamış bir repoda sessizce farklı kod çalıştırır.
save-exact=true

# Node sürümü package.json engines ile uyuşmuyorsa kur reddedilir.
engine-strict=true

# Phantom bağımlılık yok: bir paket, package.json'ında yazmadığı hiçbir şeyi import edemez.
# Halka sınırlarını (D-29) dosya sistemi seviyesinde de zorlar.
hoist=false
strict-peer-dependencies=true

# Kurulum betikleri varsayılan olarak çalışmaz; izin verilenler açıkça listelenir.
enable-pre-post-scripts=false
