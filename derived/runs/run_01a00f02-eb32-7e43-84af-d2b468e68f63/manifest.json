                {
                  "label": "Sabah özeti",
                  "detail": "Gece olanlar açılışta görünür"
                },
                {
                  "label": "Tekrar takibi",
                  "detail": "Aynı arıza geçmişiyle birlikte açılır"
                }
              ]
            },
            {
              "type": "body",
              "text": "Amir izne çıktığında bilgi de onunla gidiyor; aynı ayar hatası tekrar edince ekip aramaya baştan başlıyor, çünkü ilkini kimse yazmamıştı.",
              "islev": "kanit"
            },
            {
              "type": "body",
              "text": "Sözlü devir kötü niyet değil, kayıt yerinin hiç kurulmamış olmasıdır.",
              "islev": "donus"
            },
            {
              "type": "body",
              "text": "Vardiya devrinizin nerede kaydedildiğini sorun; net bir cevap yoksa konuşalım.",
              "islev": "davet"
            }
          ]
        },
